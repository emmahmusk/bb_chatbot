PIPENV_IGNORE_VIRTUALENVS=1

# Django
DEBUG=True
SECRET_KEY=

# Database
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# AWS (static)
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# OpticOdds sportsbook feed (set in Render's environment, do not commit a real key)
OPTIC_ODDS_API_KEY=
ADMIN_SERVER_API_KEY=
# auto uses OpticOdds when available and falls back to deterministic demo
# prices; set to demo to disable OpticOdds calls during an outage or demo.
# The production entrypoint can also read /bullbear/production/sportsbook/mode.
SPORTSBOOK_MODE=auto
OPTIC_ODDS_BASE_URL=https://api.opticodds.com/api/v3
OPTIC_ODDS_PRIMARY_SPORTSBOOK=draftkings
OPTIC_ODDS_COMPARISON_SPORTSBOOKS=draftkings,fanduel,pinnacle
OPTIC_ODDS_TIMEOUT_SECONDS=12
OPTIC_ODDS_AUDIT_MIN_DECIMAL_GAP=0.20
OPTIC_ODDS_AUDIT_MIN_RELATIVE_GAP=0.10
